dist

# Node dependencies
node_modules

# Database (runtime SQLite files)
# 必须带前导斜杠：裸写 `data/` 会匹配任意层级叫 data 的目录，
# 曾导致 server/api/data/（7 个接口）与 app/components/data/（DataHub 组件）
# 被静默排除在版本库之外 —— 全新克隆会缺失整个「超管数据枢纽」模块。
/data/
*.db
*.sqlite
*.sqlite3

# Backup archives
*.tar

# Assistant workspace memory (local only)
.workbuddy/

# Logs
logs
*.log

# Local scratch / smoke tests (not part of the deliverable)
.tmp-smoke/
*.local

# Misc
.DS_Store
.fleet
.idea
.cloudstudio

# Local env files
.env
.env.*
!.env.example

# 内部安全审计报告（含鉴权结构与历史漏洞细节，不入公开仓库）
docs/API-清单与鉴权报告.md
docs/安全审计报告-*.md
CSMS_四联需求验证报告.md
