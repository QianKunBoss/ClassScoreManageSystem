# CSMS 生产环境配置
# 复制此文件为 .env 并修改以下配置

# Session 加密密钥【必填，必须修改】
# 生成方式：openssl rand -hex 32
# 要求：至少 32 字符的随机值。生产环境如果未设置、长度不足或仍为下方示例值，
#      服务会在启动阶段直接拒绝启动（见 server/plugins/00.security-guard.ts）。
# 说明：该密钥用于加密签名会话 Cookie，泄露或可猜测将导致管理员会话可被离线伪造。
SESSION_SECRET=change-this-to-a-random-secret

# 时区
TZ=Asia/Shanghai
